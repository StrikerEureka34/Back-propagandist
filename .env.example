# Copy to .env (repo root, next to llm.py) and fill in. .env is gitignored and Claude is denied reading it.
# Fill in only the providers you use.
ANTHROPIC_API_KEY=

# The agent (agent.py). Any key left empty is skipped; the next one in the chain answers.
# Groq key 1: the planner, high-severity fixes and the summary (openai/gpt-oss-120b)
GROQ_API_KEY=
# Groq key 2: the analysts and medium/low fixes (openai/gpt-oss-20b)
GROQ_API_KEY_2=
# Groq key 3: the analysts' fallback when key 2 fails or is rate limited (openai/gpt-oss-20b)
# Groq limits each organization, not each key: a key from the same org adds no capacity.
GROQ_API_KEY_3=
# OpenRouter: the last fallback for every role (nvidia/nemotron-3.5-lightning:free)
OPENROUTER_API_KEY=

# Optional: override the first model in a role's chain
# ORCHESTRATOR_MODEL=openai/gpt-oss-120b
# WORKER_MODEL=openai/gpt-oss-20b

# Default provider for llm() when a call doesn't pass provider=...: anthropic | groq | groq2 | groq3 | openrouter
LLM_PROVIDER=anthropic
# Optional: model for that default provider (each provider has its own built-in default)
# LLM_MODEL=
